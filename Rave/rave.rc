#include <winres.h>
#include "version.hpp"

1 ICON "../assets/logo-bg.ico"
2 ICON "../assets/logo.ico"
3 RCDATA "../assets/logo.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RAVE_VERSION_MAJOR,RAVE_VERSION_MINOR,0,0
 PRODUCTVERSION RAVE_VERSION_MAJOR,RAVE_VERSION_MINOR,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "elistrrdev"
            VALUE "FileDescription", "Rave"
            VALUE "FileVersion", RAVE_VERSION_STR
            VALUE "InternalName", "Rave"
            VALUE "LegalCopyright", "Copyright (c) 2026 elistrrdev. All rights reserved."
            VALUE "OriginalFilename", "Rave.exe"
            VALUE "ProductName", "Rave"
            VALUE "ProductVersion", RAVE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
