#include <winres.h>
#include "resource.h"
#include "../Rave/version.hpp"

IDI_RAVE ICON "../assets/logo-bg.ico"
IDI_LOGO ICON "../assets/logo.ico"

#ifdef _DEBUG
IDR_PAYLOAD RCDATA "../out/Debug/Rave.exe"
#else
IDR_PAYLOAD RCDATA "../out/Release/Rave.exe"
#endif
IDR_LICENSE RCDATA "../LICENSE"

IDD_WELCOME DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Rave Setup"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Welcome to Rave Setup", IDC_TITLE, 115, 8, 195, 24
    LTEXT "", IDC_TEXT, 115, 40, 195, 140
END

IDD_LICENSE DIALOGEX 0, 0, 317, 143
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Rave Setup"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Press Page Down to see the rest of the agreement.", IDC_TEXT, 21, 1, 275, 10
    EDITTEXT IDC_LICENSE_TEXT, 21, 13, 275, 104, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "I &accept the terms of the License Agreement", IDC_ACCEPT, 21, 124, 275, 12, WS_TABSTOP
END

IDD_LOCATION DIALOGEX 0, 0, 317, 143
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Rave Setup"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Setup will install Rave in the following folder. To install in a different folder, click Browse and select another folder. Click Next to continue.", IDC_TEXT, 21, 1, 275, 28
    GROUPBOX "Destination Folder", -1, 21, 40, 275, 36
    EDITTEXT IDC_PATH, 29, 54, 200, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "B&rowse...", IDC_BROWSE, 234, 53, 55, 15, WS_TABSTOP
    LTEXT "", IDC_SPACE_REQUIRED, 21, 100, 275, 10
    LTEXT "", IDC_SPACE_AVAILABLE, 21, 112, 275, 10
END

IDD_OPTIONS DIALOGEX 0, 0, 317, 143
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Rave Setup"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Select the additional tasks you would like Setup to perform while installing Rave, then click Install.", IDC_TEXT, 21, 1, 275, 20
    AUTOCHECKBOX "Create a &Start Menu shortcut", IDC_STARTMENU, 29, 30, 260, 12, WS_TABSTOP
    AUTOCHECKBOX "Create a &Desktop shortcut", IDC_DESKTOP, 29, 46, 260, 12, WS_TABSTOP
END

IDD_INSTALL DIALOGEX 0, 0, 317, 143
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Rave Setup"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Preparing...", IDC_STATUS, 21, 1, 275, 10
    CONTROL "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 21, 14, 275, 10
    LISTBOX IDC_DETAILS, 21, 30, 275, 106, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_BORDER
END

IDD_FINISH DIALOGEX 0, 0, 317, 193
STYLE DS_SETFONT | DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Rave Setup"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Completing Rave Setup", IDC_TITLE, 115, 8, 195, 24
    LTEXT "", IDC_TEXT, 115, 40, 195, 60
    AUTOCHECKBOX "&Launch Rave", IDC_LAUNCH, 115, 110, 195, 12, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RAVE_VERSION_MAJOR,RAVE_VERSION_MINOR,0,0
 PRODUCTVERSION RAVE_VERSION_MAJOR,RAVE_VERSION_MINOR,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "elistrrdev"
            VALUE "FileDescription", "Rave Setup"
            VALUE "FileVersion", RAVE_VERSION_STR
            VALUE "InternalName", "Rave-Installer"
            VALUE "LegalCopyright", "Copyright (c) 2026 elistrrdev. All rights reserved."
            VALUE "OriginalFilename", "Rave-Installer.exe"
            VALUE "ProductName", "Rave"
            VALUE "ProductVersion", RAVE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
